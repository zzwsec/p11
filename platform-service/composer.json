{
    "name": "blackkaiser/platform-service",
    "description": "Platform Service",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-exif": "*",
        "ext-pcntl": "*",
        "ext-bcmath": "*",
        "ext-gd": "*",
        "ext-zip": "*",
        "hashids/hashids": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
